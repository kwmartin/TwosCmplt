Constants:
  -   - PER
      - 1000
FinishTime: 32*PER
Signals:
    CLK: 1
    INIT: 1
    CNT: 1
    A: 1
    B: 6
Clock:
  - clkNm: CLK
    initVal: 0
    per: PER
    delay: 0
TimeSpcs:
  - tm: 0
    vls:
      -   - INIT
          - 1
      -   - CNT
          - 0
      -   - A
          - 0
      -   - B
          - 0
  - tm: 1*PER
    vls:
      -   - B
          - 7
  - tm: 1.1*PER
    vls:
      -   - INIT
          - 0
  - tm: 1.2*PER
    vls:
      -   - CNT
          - 1
  - tm: 18.1*PER
    vls:
      -   - CNT
          - 0
