{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: debug_test.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_test.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Debugger: waveform_edit.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/waveform_edit.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Attach to port 5678",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": false
        }
    ]
}