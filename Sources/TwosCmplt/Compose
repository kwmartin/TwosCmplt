public func assignToLValue(_ lhs: LValueAST, rhs: Value, ctx: inout Context) {
    switch lhs {
    case .net(let name):
        // Simple net assignment
        ctx.write(name, rhs)

    case .bitSelect(let name, let index):
        // 1. Read full net value
        let cur = ctx.read(name)
        // 2. Modify bit at `index` in `cur` using rhs (assuming rhs is 0/1 or 1‑bit)
        let updated = writeBit(cur, at: index, with: rhs)
        // 3. Write back
        ctx.write(name, updated)

    case .partSelect(let name, let msb, let lsb):
        // 1. Read full net value
        let cur = ctx.read(name)
        // 2. Splice rhs into bits [msb:lsb] of cur
        let updated = writeSlice(cur, msb: msb, lsb: lsb, with: rhs)
        // 3. Write back
        ctx.write(name, updated)

    case .indexedPartSelect(let name, let base, let width):
        // 1. Read full net value
        let cur = ctx.read(name)
        // 2. Splice rhs into bits [base + width - 1 : base] (or your chosen convention)
        let updated = writeSlice(cur, msb: base + width - 1, lsb: base, with: rhs)
        // 3. Write back
        ctx.write(name, updated)

    case .concat(let parts):
        // Treat rhs as a packed vector and assign slices to each part, MSB-first or LSB-first
        var offset = 0
        for part in parts.reversed() {
            let w = width(of: part, ctx: ctx)     // number of bits this part occupies
            let slice = extractSlice(rhs, msb: offset + w - 1, lsb: offset)
            assignToLValue(part, rhs: slice, ctx: &ctx)
            offset += w
        }
    }
}
