:"text","text":" "},{"kind":"identifier","text":"YamlError"}]},"doc://Yams/documentation/Yams/YamlAnchorProviding":{"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YamlAnchorProviding","kind":"identifier"}],"url":"\/documentation\/yams\/yamlanchorproviding","identifier":"doc:\/\/Yams\/documentation\/Yams\/YamlAnchorProviding","title":"YamlAnchorProviding","navigatorTitle":[{"text":"YamlAnchorProviding","kind":"identifier"}],"abstract":[{"type":"text","text":"Types that conform to YamlAnchorProviding and Encodable can optionally dictate the name of"},{"type":"text","text":" "},{"type":"text","text":"a yaml anchor when they are encoded with YAMLEncoder"}],"type":"topic"},"doc://Yams/documentation/Yams/Tag":{"url":"\/documentation\/yams\/tag","abstract":[{"text":"Tags describe the the ","type":"text"},{"inlineContent":[{"text":"type","type":"text"}],"type":"emphasis"},{"text":" of a Node.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Tag"}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/Tag","role":"symbol","title":"Tag","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tag"}]},"doc://Yams/documentation/Yams/Constructor":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constructor","kind":"identifier"}],"kind":"symbol","type":"topic","title":"Constructor","url":"\/documentation\/yams\/constructor","identifier":"doc:\/\/Yams\/documentation\/Yams\/Constructor","navigatorTitle":[{"text":"Constructor","kind":"identifier"}],"abstract":[{"type":"text","text":"Constructors are used to translate "},{"type":"codeVoice","code":"Node"},{"type":"text","text":"s to Swift values."}],"role":"symbol"},"doc://Yams/documentation/Yams/RedundancyAliasingStrategy":{"role":"symbol","navigatorTitle":[{"text":"RedundancyAliasingStrategy","kind":"identifier"}],"url":"\/documentation\/yams\/redundancyaliasingstrategy","identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for detecting aliasable values in a YAML document."},{"type":"text","text":" "},{"type":"text","text":"Implementations should return RedundancyAliasingOutcome.anchor(…) for the first occurrence of a value."},{"type":"text","text":" "},{"type":"text","text":"Subsequent occurrences of the same value (where same-ness is defined by the implementation) should"},{"type":"text","text":" "},{"text":"return RedundancyAliasingOutcome.alias(…) where the contained Anchor has the same value as the previously","type":"text"},{"text":" ","type":"text"},{"text":"returned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately","type":"text"},{"text":" ","type":"text"},{"text":"informs the YAML encoder when to use aliases.","type":"text"},{"text":" ","type":"text"},{"text":"N,B. It is essential that implementations release all references to Anchors which are created by this type","type":"text"},{"text":" ","type":"text"},{"text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be","type":"text"},{"text":" ","type":"text"},{"text":"referenced by the Encoder and will itself be released.","type":"text"}],"title":"RedundancyAliasingStrategy","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"identifier"}]},"doc://Yams/documentation/Yams/Node":{"type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/Node","abstract":[{"text":"YAML Node.","type":"text"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"url":"\/documentation\/yams\/node","navigatorTitle":[{"text":"Node","kind":"identifier"}],"role":"symbol","title"