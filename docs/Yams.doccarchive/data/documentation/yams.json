he main use-case for dereferencing aliases in a YML document"},{"type":"text","text":" "},{"type":"text","text":"is when decoding into class types. If the yaml document is large and contains many references"},{"type":"text","text":" "},{"type":"text","text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts"},{"type":"text","text":" "},{"type":"text","text":"of system memory to represent highly redundant (duplicated) data structures."},{"type":"text","text":" "},{"type":"text","text":"However, if the same document is decoded into class types and the decoding uses"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"url":"\/documentation\/yams\/aliasdereferencingstrategy","title":"AliasDereferencingStrategy","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams/YamlTagProviding":{"url":"\/documentation\/yams\/yamltagproviding","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YamlTagProviding","kind":"identifier"}],"type":"topic","title":"