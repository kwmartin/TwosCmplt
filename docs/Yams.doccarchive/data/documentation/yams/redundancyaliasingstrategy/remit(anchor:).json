{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yams\/redundancyaliasingstrategy\/remit(anchor:)"]}],"identifier":{"url":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy\/remit(anchor:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Yams\/documentation\/Yams","doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy"]]},"metadata":{"role":"symbol","title":"remit(anchor:)","externalID":"s:4Yams26RedundancyAliasingStrategyP5remit6anchoryAA6AnchorC_tKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"anchor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:4Yams6AnchorC","text":"Anchor"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"required":true,"modules":[{"name":"Yams"}],"roleHeading":"Instance Method","symbolKind":"method"},"abstract":[{"type":"text","text":"Implementations must remove all reference to the supplied anchor, permitting it to be deallocated."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"anchor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Yams\/documentation\/Yams\/Anchor","text":"Anchor","preciseIdentifier":"s:4Yams6AnchorC"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}]}],"references":{"doc://Yams/documentation/Yams/RedundancyAliasingStrategy/remit(anchor:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"anchor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:4Yams6AnchorC","text":"Anchor"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"required":true,"identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy\/remit(anchor:)","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/yams\/redundancyaliasingstrategy\/remit(anchor:)","abstract":[{"text":"Implementations must remove all reference to the supplied anchor, permitting it to be deallocated.","type":"text"}],"title":"remit(anchor:)"},"doc://Yams/documentation/Yams":{"url":"\/documentation\/yams","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","role":"collection","title":"Yams","type":"topic","kind":"symbol"},"doc://Yams/documentation/Yams/RedundancyAliasingStrategy":{"role":"symbol","navigatorTitle":[{"text":"RedundancyAliasingStrategy","kind":"identifier"}],"url":"\/documentation\/yams\/redundancyaliasingstrategy","identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for detecting aliasable values in a YAML document."},{"type":"text","text":" "},{"type":"text","text":"Implementations should return RedundancyAliasingOutcome.anchor(…) for the first occurrence of a value."},{"type":"text","text":" "},{"type":"text","text":"Subsequent occurrences of the same value (where same-ness is defined by the implementation) should"},{"type":"text","text":" "},{"text":"return RedundancyAliasingOutcome.alias(…) where the contained Anchor has the same value as the previously","type":"text"},{"text":" ","type":"text"},{"text":"returned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately","type":"text"},{"text":" ","type":"text"},{"text":"informs the YAML encoder when to use aliases.","type":"text"},{"text":" ","type":"text"},{"text":"N,B. It is essential that implementations release all references to Anchors which are created by this type","type":"text"},{"text":" ","type":"text"},{"text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be","type":"text"},{"text":" ","type":"text"},{"text":"referenced by the Encoder and will itself be released.","type":"text"}],"title":"RedundancyAliasingStrategy","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"identifier"}]},"doc://Yams/documentation/Yams/Anchor":{"abstract":[{"type":"text","text":"A representation of a YAML tag see: https:\/\/yaml.org\/spec\/1.2.2\/"},{"type":"text","text":" "},{"type":"text","text":"Types interested in Encoding and Decoding Anchors should"},{"type":"text","text":" "},{"type":"text","text":"conform to YamlAnchorProviding and YamlAnchorCoding respectively."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Anchor"}],"navigatorTitle":[{"kind":"identifier","text":"Anchor"}],"url":"\/documentation\/yams\/anchor","title":"Anchor","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/Anchor"}}}