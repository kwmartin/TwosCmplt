}],"navigatorTitle":[{"text":"Options","kind":"identifier"}],"url":"\/documentation\/yams\/emitter\/options-swift.struct","title":"Emitter.Options","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/Emitter\/Options-swift.struct"},"doc://Yams/documentation/Yams":{"url":"\/documentation\/yams","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","role":"collection","title":"Yams","type":"topic","kind":"symbol"},"doc://Yams/documentation/Yams/Emitter":{"abstract":[{"text":"Class responsible for emitting libYAML events.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Emitter"}],"navigatorTitle":[{"kind":"identifier","text":"Emitter"}],"url":"\/documentation\/yams\/emitter","title":"Emitter","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/Emitter"},"doc://Yams/documentation/Yams/RedundancyAliasingStrategy":{"role":"symbol","navigatorTitle":[{"text":"RedundancyAliasingStrategy","kind":"identifier"}],"url":"\/documentation\/yams\/redundancyaliasingstrategy","identifier":"doc:\/\/Yams\/documentation\/Yams\/RedundancyAliasingStrategy","abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for detecting aliasable values in a YAML document."},{"type":"text","text":" "},{"type":"text","text":"Implementations should return RedundancyAliasingOutcome.anchor(…) for the first occurrence of a value."},{"type":"text","text":" "},{"type":"text","text":"Subsequent occurrences of the same value (where same-ness is defined by the implementation) should"},{"type":"text","text":" "},{"text":"return RedundancyAliasingOutcome.alias(…) where the contained Anchor has the same value as the previously","type":"text"},{"text":" ","type":"text"},{"text":"returned RedundancyAliasingOutcome.anchor(…). Its the identity of the Anchor values returned that ultimately","type":"text"},{"text":" ","type":"text"},{"text":"informs the YAML encoder when to use aliases.","type":"text"},{"text":" ","type":"text"},{"text":"N,B. It is essential that implementations release all references to Anchors which are created by this type","type":"text"},{"text":" ","type":"text"},{"text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be","type":"text"},{"text":" ","type":"text"},{"text":"referenced by the Encoder and will itself be released.","type":"text"}],"title":"RedundancyAliasingStrategy","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"identifier"}]},"doc://Yams/documentation/Yams/Emitter/Options-swift.struct/redundancyAliasingStrategy":{"type":"topic","kind":"symbol","title":"redundancyAliasingStrategy","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/Emitter\/Options-swift.struct\/redundancyAliasingStrategy","url":"\/documentation\/yams\/emitter\/options-swift.struct\/redundancyaliasingstrategy","abstract":[{"text":"Redundancy aliasing strategy to use when encoding. Defaults to nil","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"redundancyAliasingStrategy","kind":"identifier"},{"text":": (any ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"typeIdentifier","preciseIdentifier":"s:4Yams26RedundancyAliasingStrategyP"},{"text":")?","kind":"text"}]}}}