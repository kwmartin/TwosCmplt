{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"aliasDereferencingStrategy"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy","text":"AliasDereferencingStrategy"},{"kind":"text","text":")?"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/yams\/yamldecoder\/options-swift.struct\/aliasdereferencingstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"aliasDereferencingStrategy","kind":"identifier"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP","text":"AliasDereferencingStrategy","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"modules":[{"name":"Yams"}],"externalID":"s:4Yams11YAMLDecoderC7OptionsV26aliasDereferencingStrategyAA05AliaseF0_pSgvp","title":"aliasDereferencingStrategy","roleHeading":"Instance Property","symbolKind":"property","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct\/aliasDereferencingStrategy"},"hierarchy":{"paths":[["doc:\/\/Yams\/documentation\/Yams","doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder","doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct"]]},"abstract":[{"type":"text","text":"Alias dereferencing strategy to use when decoding. Defaults to nil"}],"references":{"doc://Yams/documentation/Yams/YAMLDecoder/Options-swift.struct":{"url":"\/documentation\/yams\/yamldecoder\/options-swift.struct","type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct","role":"symbol","abstract":[{"text":"Options to use when decoding from YAML.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Options","kind":"identifier"}],"title":"YAMLDecoder.Options","navigatorTitle":[{"text":"Options","kind":"identifier"}]},"doc://Yams/documentation/Yams/AliasDereferencingStrategy":{"abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for dereferencing aliases (or dealiasing) values during"},{"type":"text","text":" "},{"type":"text","text":"YAML document decoding. YAML documents which do not contain anchors will not benefit from the use of"},{"type":"text","text":" "},{"type":"text","text":"an AliasDereferencingStrategy in any way. The main use-case for dereferencing aliases in a YML document"},{"type":"text","text":" "},{"type":"text","text":"is when decoding into class types. If the yaml document is large and contains many references"},{"type":"text","text":" "},{"type":"text","text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts"},{"type":"text","text":" "},{"type":"text","text":"of system memory to represent highly redundant (duplicated) data structures."},{"type":"text","text":" "},{"type":"text","text":"However, if the same document is decoded into class types and the decoding uses"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"url":"\/documentation\/yams\/aliasdereferencingstrategy","title":"AliasDereferencingStrategy","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams/YAMLDecoder/Options-swift.struct/aliasDereferencingStrategy":{"url":"\/documentation\/yams\/yamldecoder\/options-swift.struct\/aliasdereferencingstrategy","type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder\/Options-swift.struct\/aliasDereferencingStrategy","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Alias dereferencing strategy to use when decoding. Defaults to nil"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"aliasDereferencingStrategy","kind":"identifier"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP","text":"AliasDereferencingStrategy","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"title":"aliasDereferencingStrategy"},"doc://Yams/documentation/Yams/YAMLDecoder":{"url":"\/documentation\/yams\/yamldecoder","type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/YAMLDecoder","role":"symbol","abstract":[{"type":"codeVoice","code":"Codable"},{"type":"text","text":"-style "},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" that can be used to decode a "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" type from a given "},{"code":"String","type":"codeVoice"},{"type":"text","text":" and optional"},{"type":"text","text":" "},{"type":"text","text":"user info mapping. Similar to "},{"code":"Foundation.JSONDecoder","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLDecoder"}],"title":"YAMLDecoder","navigatorTitle":[{"kind":"identifier","text":"YAMLDecoder"}]},"doc://Yams/documentation/Yams":{"url":"\/documentation\/yams","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","role":"collection","title":"Yams","type":"topic","kind":"symbol"}}}