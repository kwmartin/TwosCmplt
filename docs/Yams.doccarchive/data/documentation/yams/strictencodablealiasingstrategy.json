eferences to Anchors which are created by this type","type":"text"},{"text":" ","type":"text"},{"text":"when releaseAnchorReferences() is called by the Encoder. After this call the implementation will no longer be","type":"text"},{"text":" ","type":"text"},{"text":"referenced by the Encoder and will itself be released.","type":"text"}],"title":"RedundancyAliasingStrategy","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RedundancyAliasingStrategy","kind":"identifier"}]},"doc://Yams/documentation/Yams":{"url":"\/documentation\/yams","abstract":[],"identifier":"doc:\/\/Yams\/documentation\/Yams","role":"collection","title":"Yams","type":"topic","kind":"symbol"},"doc://Yams/documentation/Yams/StrictEncodableAliasingStrategy/init()":{"identifier":"doc:\/\/Yams\/documentation\/Yams\/StrictEncodableAliasingStrategy\/init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"kind":"symbol","title":"init()","type":"topic","abstract":[{"type":"text","text":"Initialize a new StrictEncodableAliasingStrategy"}],"role":"symbol","url":"\/documentation\/yams\/strictencodablealiasingstrategy\/init()"},"doc://Yams/documentation/Yams/StrictEncodableAliasingStrategy":{"title":"StrictEncodableAliasingStrategy","url":"\/documentation\/yams\/strictencodablealiasingstrategy","kind":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/StrictEncodableAliasingStrategy","role":"symbol","navigatorTitle":[{"text":"StrictEncodableAliasingStrategy","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StrictEncodableAliasingStrategy","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"An implementation of RedundancyAliasingStrategy that defines alias-ability by the coded representation"},{"type":"text","text":" "},{"type":"text","text":"of the values. i.e. if two values encode to exactly the same, they will be aliased in the re