"}]},"references":{"doc://Yams/documentation/Yams/AliasDereferencingStrategy/Value":{"identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy\/Value","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"kind":"symbol","title":"AliasDereferencingStrategy.Value","type":"topic","abstract":[{"text":"The stored exestential type of all AliasDereferencingStrategys","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Value"}],"url":"\/documentation\/yams\/aliasdereferencingstrategy\/value"},"doc://Yams/documentation/Yams/Anchor":{"abstract":[{"type":"text","text":"A representation of a YAML tag see: https:\/\/yaml.org\/spec\/1.2.2\/"},{"type":"text","text":" "},{"type":"text","text":"Types interested in Encoding and Decoding Anchors should"},{"type":"text","text":" "},{"type":"text","text":"conform to YamlAnchorProviding and YamlAnchorCoding respectively."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Anchor"}],"navigatorTitle":[{"kind":"identifier","text":"Anchor"}],"url":"\/documentation\/yams\/anchor","title":"Anchor","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/Anchor"},"doc://Yams/documentation/Yams/AliasDereferencingStrategy":{"abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for dereferencing aliases (or dealiasing) values during"},{"type":"text","text":" "},{"type":"text","text":"YAML document decoding. YAML documents which do not contain anchors will not benefit from the use of"},{"type":"text","text":" "},{"type":"text","text":"an AliasDereferencingStrategy in any way. The main use-case for dereferencing aliases in a YML document"},{"type":"text","text":" "},{"type":"text","text":"is when decoding into class types. If the yaml document is large and contains many references"},{"type":"text","text":" "},{"type":"text","text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts"},{"type":"text","text":" "},{"type":"text","text":"of system memory to represent highly redundant (duplicated) data structures."},{"type":"text","text":" "},{"type":"text","text":"However, if the same document is decoded into class types and the decoding uses"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"url":"\/documentation\/yams\/aliasdereferencingstrategy","title":"AliasDereferencingStrategy","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams/AliasDereferencingStrategy/subscript(_:)":{"required":true,"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:4Yams6AnchorC","text":"Anchor","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:4Yams26AliasDereferencingStrategyP5Valuea","text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"subscript(_:)","abstr