"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"]}],"kind":"symbol","references":{"doc://Yams/documentation/Yams/AliasDereferencingStrategy":{"abstract":[{"type":"text","text":"A class-bound protocol which implements a strategy for dereferencing aliases (or dealiasing) values during"},{"type":"text","text":" "},{"type":"text","text":"YAML document decoding. YAML documents which do not contain anchors will not benefit from the use of"},{"type":"text","text":" "},{"type":"text","text":"an AliasDereferencingStrategy in any way. The main use-case for dereferencing aliases in a YML document"},{"type":"text","text":" "},{"type":"text","text":"is when decoding into class types. If the yaml document is large and contains many references"},{"type":"text","text":" "},{"type":"text","text":"(perhaps it is a representation of a dense graph) then, decoding into structs will require the of large amounts"},{"type":"text","text":" "},{"type":"text","text":"of system memory to represent highly redundant (duplicated) data structures."},{"type":"text","text":" "},{"type":"text","text":"However, if the same document is decoded into class types and the decoding uses"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"AliasDereferencingStrategy"},{"text":" such as ","type":"text"},{"type":"codeVoice","code":"BasicAliasDereferencingStrategy"},{"text":" then the emitted value will have its","type":"text"},{"text":" ","type":"text"},{"text":"class references coalesced. No duplicate objects will be initialized (unless identical objects have multiple","type":"text"},{"text":" ","type":"text"},{"text":"distinct anchors in the YAML document). In some scenarios this may significantly reduce the memory footprint of","type":"text"},{"text":" ","type":"text"},{"text":"the decoded type.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AliasDereferencingStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"AliasDereferencingStrategy"}],"url":"\/documentation\/yams\/aliasdereferencingstrategy","title":"AliasDereferencingStrategy","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yams\/documentation\/Yams\/AliasDereferencingStrategy"},"doc://Yams/documentation/Yams/BasicAliasDereferencingStrategy/init()":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy\/init()","title":"init()","url":"\/documentation\/yams\/basicaliasdereferencingstrategy\/init()","abstract":[{"text":"Create a new BasicAliasDereferencingStrategy","type":"text"}],"role":"symbol"},"doc://Yams/documentation/Yams/BasicAliasDereferencingStrategy":{"type":"topic","abstract":[{"text":"A AliasDereferencingStrategy which caches all values (even value-type values) in a Dictionary,","type":"text"},{"text":" ","type":"text"},{"text":"keyed by their Anchor.","type":"text"},{"text":" ","type":"text"},{"text":"For reference types, this strategy achieves reference coalescing","type":"text"},{"text":" ","type":"text"},{"text":"For value types, this strategy achieves short-cutting the decoding process when dereferencing aliases.","type":"text"},{"text":" ","type":"text"},{"text":"if the aliased structure is large, this may result in a time savings","type":"text"}],"role":"symbol","kind":"symbol","title":"BasicAliasDereferencingStrategy","url":"\/documentation\/yams\/basicaliasdereferencingstrategy","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BasicAliasDereferencingStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"BasicAliasDereferencingStrategy","kind":"identifier"}],"identifier":"doc:\/\/Yams\/documentation\/Yams\/BasicAliasDereferencingStrategy"},"doc://Yams/documentation/Yams/BasicAliasDereferencingStr