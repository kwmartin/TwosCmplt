{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/+=(_:_:)-5qql"},"sections":[],"abstract":[{"type":"text","text":"Overload += to add two two’s complement integers"},{"type":"text","text":" "},{"type":"text","text":"The prec is the larger prec of the two arguments. The other prec is"},{"type":"text","text":" "},{"type":"text","text":"adjusted to match before doing the addition."},{"type":"text","text":" "},{"type":"text","text":"The nbits is the larger nbits of the two arguments after adjusting for prec."},{"type":"text","text":" "},{"type":"text","text":"If either argument is signed, the output is signed"},{"type":"text","text":" "},{"type":"text","text":"The crry and ovflw are set if there is a carry or an overflow."},{"type":"text","text":" "},{"type":"text","text":"The default for States.addMode is .overflow and allows for overflows."},{"type":"text","text":" "},{"type":"text","text":"If States.addMode = .saturate, then in the case of overflow, the values"},{"type":"text","text":" "},{"type":"text","text":"stored are the maximum or minimum possible values."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"+="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"internalParam","text":"lhs"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SharedTypes8TwoCmpltV","text":"TwoCmplt"},{"kind":"text","text":", "},{"kind":"internalParam","text":"rhs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SharedTypes8TwoCmpltV","text":"TwoCmplt"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"lhs","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two