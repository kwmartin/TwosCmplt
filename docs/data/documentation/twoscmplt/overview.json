{"hierarchy":{"paths":[["doc:\/\/TwosCmplt\/documentation\/TwoComplement"]]},"sections":[],"metadata":{"title":"Overview","role":"article","roleHeading":"Article"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/TwosCmplt\/documentation\/TwosCmplt","doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/CoeffMlt","doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/FilterIntro"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/Overview"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Project-introduction-and-summary","text":"Project introduction and summary."},{"inlineContent":[{"type":"text","text":"A TwoCmplt struct contains the value (called value, an Int) of the two’s complement variable, and"},{"type":"text","text":" "},{"type":"text","text":"properties defining the variable. These properties describe the number of bits"},{"type":"text","text":" "},{"type":"text","text":"used for the variable (nbits, an Int), whether the variable is considered to be signed"},{"type":"text","text":" "},{"type":"text","text":"or unsigned (signed, a Bool), and the precision if it’s not zero (prec, an Int). The precision"},{"type":"text","text":" "},{"type":"text","text":"determines how the value should be scaled when it is combined with other two’s complement"},{"type":"text","text":" "},{"type":"text","text":"integer similar to how Matlab represents two’s complement variables using it’s “fi” objects."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.mathworks.com\/help\/fixedpoint\/ug\/perform-fixed-point-arithmetic.html"}],"type":"paragraph"}]}],"references":{"doc://TwosCmplt/documentation/TwoComplement":{"role":"collection","identifier":"doc:\/\/TwosCmplt\/documentation\/TwoComplement","url":"\/documentation\/twocomplement","title":"TwoComplement","abstract":[{"type":"text","text":"This library is intended to simplify using Swift to model signal processing blocks"},{"type":"text","text":" "},{"type":"text","text":"implemented using two’s complement arithmetic. Think of it a start towards extending Swift"},{"type":"text","text":" "},{"type":"text","text":"to System-Swift, as an alternative to System-C. The library is a port from a Python library so"},{"type":"text","text":" "},{"type":"text","text":"much (but not all) of the debugging has been done."}],"kind":"article","type":"topic"},"doc://TwosCmplt/documentation/TwosCmplt/CoeffMlt":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoeffMlt","kind":"identifier"}],"navigatorTitle":[{"text":"CoeffMlt","kind":"identifier"}],"type":"topic","kind":"symbol","title":"CoeffMlt","identifier":"doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/CoeffMlt","role":"symbol","abstract":[{"text":"Contains properties and functions used to implement fixed coefficient multiplication.","type":"text"}],"url":"\/documentation\/twoscmplt\/coeffmlt"},"https://www.mathworks.com/help/fixedpoint/ug/perform-fixed-point-arithmetic.html":{"title":"Matlab Fixed-Point Arithmetic Documentation","type":"link","titleInlineContent":[{"type":"text","text":"Matlab Fixed-Point Arithmetic Documentation"}],"url":"https:\/\/www.mathworks.com\/help\/fixedpoint\/ug\/perform-fixed-point-arithmetic.html","identifier":"https:\/\/www.mathworks.com\/help\/fixedpoint\/ug\/perform-fixed-point-arithmetic.html"},"doc://TwosCmplt/documentation/TwosCmplt/FilterIntro":{"type":"topic","kind":"article","title":"FilterIntro","identifier":"doc:\/\/TwosCmplt\/documentation\/TwosCmplt\/FilterIntro","role":"article","abstract":[{"type":"text","text":"When digital filters need to be realized that can operate at high clock frequencies,"},{"type":"text","text":" "},{"type":"text","text":"filters based on using two’s complement arithmetic is ofter a preferred choice."},{"type":"text","text":" "},{"type":"text","text":"The TwoCmplt Library is intended to help simulate high-level, bit-accurate"},{"type":"text","text":" "},{"type":"text","text":"filters with minimal effort."}],"url":"\/documentation\/twoscmplt\/filterintro"},"doc://TwosCmplt/documentation/TwosCmplt":{"role":"collection","identifier":"doc:\/\/TwosCmplt\/documentation\/TwosCmplt","url":"\/documentation\/twoscmplt","title":"TwosCmplt","abstract":[],"kind":"symbol","type":"topic"}}}