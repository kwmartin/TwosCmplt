{"kind":"symbol","abstract":[{"type":"text","text":"A simple example of a second order oscillator with very high frequency resolution. One use of this block"},{"type":"text","text":" "},{"type":"text","text":"is for generating high quality on-chip test signals for A\/D’s. Note also that generating sine waves using"},{"type":"text","text":" "},{"type":"text","text":"this approach has much less latency as compared to generating sine waves using DDFS’s."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/CoeffMltply\/documentation\/CoeffMltply"]]},"identifier":{"url":"doc:\/\/CoeffMltply\/documentation\/CoeffMltply\/SimOsc3(coeff:accum:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:11CoeffMltply7SimOsc35coeff5accumySi_SitF","roleHeading":"Function","title":"SimOsc3(coeff:accum:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"SimOsc3"},{"kind":"text","text":"("},{"kind":"externalParam","text":"coeff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"accum"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"symbolKind":"func","modules":[{"name":"CoeffMltply"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"SimOsc3"},{"kind":"text","text":"("},{"kind":"externalParam","text":"coeff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"accum"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The coeff specifies the multiplication constant. It is a fraction between 0","type":"text"},{"text":" ","type":"text"},{"text":"and 1. For a 16-bit signal path, the muliplication constant is taken coeff = K","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"65536 (i.e. 1<<16)."},{"type":"text","text":" "},{"type":"text","text":"The equation governing the frequency of oscillation is K = 2"}]},{"text":"sin(pi*f0) where f0 is a fraction; for","type":"text"},{"text":" ","type":"text"},{"text":"example, if the oscillation period 16 clock cycles, take f0 = 1\/16.","type":"text"}]}],"name":"coeff"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Added to 24-bit X2 each clock period. The carry-out of X2 is added to coeff"},{"type":"text","text":" "},{"type":"text","text":"to give much greater resolution on the frequency of oscillation."}]}],"name":"accum"}],"kind":"parameters"}],"sections":[],"variants":[{"paths":["\/documentation\/coeffmltply\/simosc3(coeff:accum:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://CoeffMltply/documentation/CoeffMltply/SimOsc3(coeff:accum:)":{"identifier":"doc:\/\/CoeffMltply\/documentation\/CoeffMltply\/SimOsc3(coeff:accum:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"SimOsc3"},{"kind":"text","text":"("},{"kind":"externalParam","text":"coeff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"accum"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A simple example of a second order oscillator with very high frequency resolution. One use of this block"},{"type":"text","text":" "},{"type":"text","text":"is for generating high quality on-chip test signals for A\/D’s. Note also that generating sine waves using"},{"type":"text","text":" "},{"type":"text","text":"this approach has much less latency as compared to generating sine waves using DDFS’s."}],"role":"symbol","url":"\/documentation\/coeffmltply\/simosc3(coeff:accum:)","title":"SimOsc3(coeff:accum:)","kind":"symbol"},"doc://CoeffMltply/documentation/CoeffMltply":{"identifier":"doc:\/\/CoeffMltply\/documentation\/CoeffMltply","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/coeffmltply","title":"CoeffMltply","kind":"symbol"}}}