{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/CoeffMltply\/documentation\/CoeffMltply"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SimOsc1","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"coeff","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"coeff","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The coeff specifies the multiplication constant. It is a fraction between 0"},{"type":"text","text":" "},{"type":"text","text":"and 1. For a 16-bit signal path, the muliplication constant is taken coeff = K"},{"type":"emphasis","inlineContent":[{"type":"text","text":"65536 (i.e. 1<<16)."},{"type":"text","text":" "},{"type":"text","text":"The equation governing the frequency of oscillation is K = 2"}]},{"type":"text","text":"sin(pi*f0) where f0 is a fraction; for"},{"type":"text","text":" "},{"type":"text","text":"example, if the oscillation period 16 clock cycles, take f0 = 1\/16."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coeffmltply\/simosc1(_:)"]}],"metadata":{"modules":[{"name":"CoeffMltply"}],"roleHeading":"Function","symbolKind":"func","title":"SimOsc1(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"SimOsc1"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"role":"symbol","externalID":"s:11CoeffMltply7SimOsc1yySiF"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CoeffMltply\/documentation\/CoeffMltply\/SimOsc1(_:)"},"abstract":[{"text":"A